# Copy this file to ".env" and paste your own keys.
# The real ".env" file is ignored by Git, so your keys stay private.

# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get a key at https://app.pinecone.io (API Keys section)
PINECONE_API_KEY=your_pinecone_api_key_here
